<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.trabajosesion</groupId>
    <artifactId>gestionstock</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>gestionstock</name>
    <description>
        Ejercicio "a": gestion de productos, proveedores y ordenes de compra
        a mayoristas. MVC + 3 capas + DTO + JPA/Hibernate + MySQL + Thymeleaf
        + Bootstrap + login con usuario y contrasena.
    </description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- Spring MVC + Tomcat embebido: capa Controller. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Motor de plantillas Thymeleaf: capa View. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- Spring Data JPA + Hibernate: ORM, base de la capa DAO. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Driver JDBC de MySQL. -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Bean Validation (@NotBlank, @NotNull, @Positive, etc.) para los DTO. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            spring-security-crypto: ES SOLO el modulo de utilidades
            criptograficas de Spring Security (contiene BCryptPasswordEncoder),
            NO el starter completo de Spring Security. Se elige
            deliberadamente esta dependencia "pequeña" en lugar de
            spring-boot-starter-security para poder hashear contrasenas de
            forma estandar (bcrypt) sin traer automaticamente filtros de
            seguridad, formularios de login propios de Spring Security,
            ni una arquitectura de seguridad mas compleja de la que pide
            este ejercicio (el login se maneja "a mano" con HttpSession,
            igual que en el ejercicio anterior).
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
