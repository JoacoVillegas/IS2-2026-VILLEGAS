<?xml version="1.0" encoding="UTF-8"?>
<!--
    POM DEL PROYECTO "sistemacompras"
    ==================================
    Este archivo es el descriptor de Maven: define de qué depende el proyecto
    (librerías), cómo se compila y cómo se empaqueta.

    NOTA SOBRE EL PROYECTO DE REFERENCIA (proyectosesion):
    El proyecto de login que se usó como referencia declaraba la versión
    "4.1.1" de spring-boot-starter-parent y una dependencia inexistente
    llamada "spring-boot-starter-webmvc". Ninguna de las dos cosas es válida:
    la versión estable y ampliamente documentada de Spring Boot en la familia
    3.x es la que se usa aquí, y el starter real para desarrollar
    aplicaciones web con Spring MVC se llama "spring-boot-starter-web".
    Se corrige acá para que el proyecto compile y sea reproducible.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        spring-boot-starter-parent gestiona automáticamente las versiones
        compatibles entre sí de todas las dependencias de Spring Boot,
        para que no tengamos que fijar versión por cada starter.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.trabajosesion</groupId>
    <artifactId>sistemacompras</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>sistemacompras</name>
    <description>
        Sistema de usuarios, productos, inventario y compras.
        Ejercicio "a": MVC + arquitectura de 3 capas + ORM/JPA + MySQL + Thymeleaf + Bootstrap.
    </description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!--
            spring-boot-starter-web:
            Trae Spring MVC (DispatcherServlet, @Controller, @RequestMapping, etc.)
            y un servidor Tomcat embebido. Es la base de la capa Controller.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            spring-boot-starter-thymeleaf:
            Integra el motor de plantillas Thymeleaf con Spring MVC. Permite
            que los Controllers devuelvan nombres de vistas (.html en
            /templates) que Thymeleaf resuelve combinando HTML + datos del
            Model. Es la base de la capa View pedida por el enunciado.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!--
            spring-boot-starter-data-jpa:
            Trae Hibernate (implementación de JPA) y Spring Data JPA
            (generación automática de repositorios). Es la base de la
            capa DAO / acceso a datos mediante ORM.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
            Conector JDBC de MySQL. Es el driver concreto que Hibernate usa
            por debajo para dialogar con el motor de base de datos MySQL.
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            spring-boot-starter-validation:
            Habilita las anotaciones de Bean Validation (@NotBlank, @Email,
            @Size, etc.) usadas en los formularios para validar los datos
            que llegan desde las vistas Thymeleaf antes de pasarlos al Service.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
